[Unit]
Description=FlowCapital News Scheduler
After=flowcapital-api.service
Wants=flowcapital-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/flowcapital
Environment="PYTHONPATH=/opt/flowcapital"
Environment="PUSHGATEWAY_URL=localhost:9091"
EnvironmentFile=/opt/flowcapital/.env
ExecStart=/usr/bin/python3 scripts/scheduler.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/flowcapital/logs/scheduler.log
StandardError=append:/opt/flowcapital/logs/scheduler-error.log

[Install]
WantedBy=multi-user.target
