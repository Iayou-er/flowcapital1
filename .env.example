# ========================================
# GraphRAG LLM 配置
# ========================================
# 阿里云（默认）
LLM_API_KEY=your_api_key_here
LLM_API_TYPE=aliyun
LLM_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-plus

# OpenAI（取消注释并注释上方阿里云配置来使用）
# LLM_API_KEY=your_openai_key_here
# LLM_API_TYPE=openai
# LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o

# ========================================
# 运行环境
# ========================================
# development: 显示详细错误信息, 允许 localhost CORS
# production: 隐藏错误详情, 严格 CORS
ENVIRONMENT=development

# ========================================
# API 认证配置
# ========================================
# 生产环境务必设为 true + 强密钥
ENABLE_AUTH=false
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-api-key-here

# CORS 配置（逗号分隔，生产环境替换为实际域名）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=900

# ========================================
# 翻译 API 配置（可选，不配置会自动降级到 MyMemory 免费翻译）
# ========================================
TRANSLATE_API_TYPE=baidu
TRANSLATE_APP_ID=
TRANSLATE_APP_KEY=
